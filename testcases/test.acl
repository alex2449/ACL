import "/usr/local/share/acl/lib/lib.acl";

struct Pair {
    x int;
    y int;
};

function Pair.make() returns (Pair) {
    return Pair({0, 0});
}

function (p *Pair) print() {
    print("(");
    print(p->x);
    print(", ");
    print(p->y);
    print(")");
    print("\n");
}

struct List {
    values []int;
};

function (l *List) take() returns (List) {
    print("Taking list: ");
    l->print();
    return {l->values.take()};
}

function (l *List) drop() {
    print("Dropping list: ");
    l->print();
    l->values.drop();
}

function (l *List) print() {
    print("(");
    for (var i uint, n uint := (0, l->values.length); i < n; i = i + 1) {
        print(l->values[i]);
        if (i < n - 1)
            print(", ");
    }
    print(")\n");
}

variant V {
    int32,
    int64
};

function main([*]str) returns (int32) {
    var p := new Pair({1, 2});
    p->print();

    var v := V(int64(100));

    if (v is int64) {
        print(v.(int64));
        print("\n");
    }

    var lst1 := List({1, 2, 3, 4, 5});
    var lst2 := lst1;
    return 0;
}
