import "/usr/local/share/acl/lib/lib.acl";

struct S {
    x ^int32;
};

function f() returns ([2][1]^int32) {
    return {{new int32(42)}, {new int32(17)}};
}

function main([*]str) returns (int32) {
    var i int := 0;

    while (true) {
        var x [2]^S := {new S(new int32(17)), new S(new int32(99))};
        var y [2][1]^int32 := f();

        if (i == 42) {
            print(*x[0]->x + *y[0][0]);
            print('\n');
            return 0;
        }

        i = i + 1;
    }
}
